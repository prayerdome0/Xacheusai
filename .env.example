# =============================================================================
# Xacheus AI — environment configuration
# Copy to `.env` and fill in what you actually have.
# EVERYTHING IS OPTIONAL. Xacheus boots with zero credentials and runs the
# built-in local planner with connectors in "sandbox" mode.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Owner passcode for the local Control Center (change this). If unset, auth is
# disabled and the server warns loudly — only acceptable on a trusted LAN.
XACHEUS_OWNER_PASSCODE=change-me
# Optional: only accept Firebase sign-ins from this email address as the owner.
XACHEUS_OWNER_EMAIL=
# Directory for local persistence (memory, audit, knowledge index, uploads)
XACHEUS_DATA_DIR=.data
# Comma-separated origins allowed to call the API. "*" for dev.
XACHEUS_CORS_ORIGINS=*
# Root directory the Code Agent may read and write. Defaults to the repo root.
XACHEUS_WORKSPACE_ROOT=

# ---------------------------------------------------------------------------
# AI MODEL LAYER  (modular — pick one, or leave empty for the built-in planner)
# XACHEUS_MODEL=ollama | openai | anthropic | heuristic
# ---------------------------------------------------------------------------
XACHEUS_MODEL=heuristic

# -- Local / open model via Ollama (recommended first step: fully private) --
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# -- OpenAI-compatible endpoint (works with OpenAI, Groq, Together, vLLM, LM Studio, OpenRouter) --
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -- Anthropic --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# FIREBASE  (auth, Firestore, notifications)
# The web apiKey below is PUBLIC by design (it ships in every browser bundle).
# Real protection comes from Firestore security rules + Firebase Auth.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Service account JSON (server-side, Firestore access). Path to a file, or the
# JSON itself pasted onto one line. Firestore needs this — the web apiKey above
# only identifies the project, it cannot write data.
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Storage driver: json (default, local) | firestore | memory
# On serverless hosting (Vercel and friends) the filesystem is temporary, so this
# MUST be firestore for anything you care about: Xacheus refuses to start with
# local files there rather than let your data vanish quietly.
XACHEUS_STORAGE=json

# ---------------------------------------------------------------------------
# WEB SEARCH / RESEARCH AGENT
# Without a key the Research agent still runs, but reports that results are
# simulated rather than scraping the live web.
# ---------------------------------------------------------------------------
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# CLOUDINARY  (images, documents, media, generated assets)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=xacheus

# ---------------------------------------------------------------------------
# SOCIAL CONNECTORS  (live when credentials present, sandbox otherwise)
# ---------------------------------------------------------------------------
# Facebook Page (Meta Graph API)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram Business (via Graph API)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret. Inbound webhooks are refused (503) until this is set, because
# the endpoint verifies the X-Hub-Signature-256 HMAC rather than an owner passcode.
WHATSAPP_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# EMAIL  (IMAP/SMTP) — used by the Mail agent when configured
# ---------------------------------------------------------------------------
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# SMART HOME  (Home Assistant REST API is the default bridge)
# ---------------------------------------------------------------------------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Room/floor grouping used by "turn off everything downstairs"
HOME_AREAS={"downstairs":["living_room","kitchen","hall"],"upstairs":["bedroom","office"]}

# ---------------------------------------------------------------------------
# CUSTOM API CONNECTOR
# Private/LAN targets are refused by default so a model-authored URL cannot be
# used to probe your internal network. Opt in only for services you own.
# ---------------------------------------------------------------------------
XACHEUS_ALLOW_PRIVATE_API=false

# ---------------------------------------------------------------------------
# SCHEDULING (serverless hosting)
# A function that sleeps between requests cannot run an in-process scheduler, so
# point a cron at GET/POST /api/tasks/tick and set a secret for it. Vercel Cron
# sends CRON_SECRET automatically as a bearer token.
# ---------------------------------------------------------------------------
CRON_SECRET=
# Set to true ONLY to look around on a platform with a temporary filesystem:
# nothing you store will survive, and the console will say so.
XACHEUS_ALLOW_EPHEMERAL_STORAGE=false

# ---------------------------------------------------------------------------
# ANDROID BRIDGE  (pairing secret shared with the companion app)
# ---------------------------------------------------------------------------
XACHEUS_DEVICE_BRIDGE_TOKEN=generate-a-long-random-string
