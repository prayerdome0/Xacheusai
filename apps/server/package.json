{
  "name": "@xacheus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xacheus AI backend: inference orchestration, agents, tools, memory, knowledge, connector gateway",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run build -w @xacheus/core",
    "build": "npx tsc -p tsconfig.json",
    "dev": "npx tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build -w @xacheus/core",
    "typecheck": "npx tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xacheus/core": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
